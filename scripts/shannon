#!/usr/bin/env bash
# shannon — dual-product operator handrail for Shannon UI + Shannon CLI
#
# Two named products (not one mixed binary):
#
#   Shannon UI   — macOS menu-bar / notch HUD (repo: LeBonhommePharma/ShannonUI)
#   Shannon CLI  — headless entropy, gate, agent, science tooling (this repo)
#
#   ./scripts/shannon              # pets + optional gate/bridge (+ UI if available)
#   ./scripts/shannon app          # rebuild/install/start Shannon UI (needs ShannonUI tree)
#   ./scripts/shannon start|stop|restart|status|probe
#   ./scripts/shannon pets         # create default pets only
#   ./scripts/shannon help         # dual-product command map (headless)
#
# Headless Shannon CLI (no AppKit / no ShannonPill launch):
#   ./scripts/shannon status|probe|gate|agent|export|science|help
#   ./scripts/shannon grok|claude|codex …   # Ori-style harness
#   shannon-monitor --help
#   shannon grok --dry-run          # Ori-style harness (real grok/claude/codex on PATH)
#   python3 -m agent_manager …
#
# Shannon UI source lives in ShannonUI (not this tree). Resolve order for builds:
#   1) $SHANNON_UI_ROOT   2) sibling ../ShannonUI   3) legacy local Pill/ (if present)
# Legacy dual status-item UI is archived under archive/legacy_agent_hub_ui/ — not shipped.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HUB="${REPO}/hub"
APP="/Applications/Shannon.app"
BIN="${APP}/Contents/MacOS/ShannonPill"
PETS_DIR="${HOME}/.shannon/pets"
SHANNON_UI_URL="${SHANNON_UI_URL:-https://github.com/LeBonhommePharma/ShannonUI}"
CMD="${1:-}"
# Default with no args = full bootstrap (plan acceptance #1).
if [[ -z "${CMD}" ]]; then
  CMD="bootstrap"
else
  shift
fi

info()  { printf '→ %s\n' "$*"; }
ok()    { printf '✓ %s\n' "$*"; }
die()   { printf '✗ %s\n' "$*" >&2; exit 1; }
warn()  { printf '! %s\n' "$*" >&2; }

is_running() { pgrep -x ShannonPill >/dev/null 2>&1; }

# shellcheck source=lib_shannon_ui.sh
source "${REPO}/scripts/lib_shannon_ui.sh"
PILL=""
if resolve_shannon_ui; then
  PILL="${PILL_DIR}"
fi

# ── App lifecycle ─────────────────────────────────────────────────────────────

stop_app() {
  if is_running; then
    info "Stopping Shannon…"
    pkill -x ShannonPill 2>/dev/null || true
    for _ in 1 2 3 4 5 6; do
      is_running || break
      sleep 0.5
    done
    pkill -9 -x ShannonPill 2>/dev/null || true
    rm -f "${HOME}/.shannon/pill.lock"
    ok "Stopped"
  else
    ok "Not running"
  fi
}

start_app() {
  [[ -x "${BIN}" ]] || die "Not installed. Run: ./scripts/shannon app"
  if is_running; then
    open "${APP}" 2>/dev/null || true
    ok "Already running — brought forward"
    return 0
  fi
  rm -f "${HOME}/.shannon/pill.lock"
  xattr -dr com.apple.quarantine "${APP}" 2>/dev/null || true
  if ! open "${APP}" 2>/dev/null; then
    # Headless / no GUI session — still consider install success.
    warn "Could not open GUI (no display?). App is installed at ${APP}"
    warn "Start later with: open ${APP}   or   ./scripts/shannon start"
    return 0
  fi
  sleep 1.2
  if is_running; then
    ok "Shannon is running"
  else
    warn "Launched but process not seen yet — try: ./scripts/shannon probe"
  fi
}

build_and_install() {
  if [[ -z "${PILL}" ]]; then
    die "Shannon UI source not found (private LeBonhommePharma/ShannonUI).
  SSH:    git clone git@github.com:LeBonhommePharma/ShannonUI.git ../ShannonUI
  gh:     gh repo clone LeBonhommePharma/ShannonUI ../ShannonUI
  Or set: export SHANNON_UI_ROOT=/path/to/ShannonUI
  Or cask: brew install --cask lebonhommepharma/shannon/shannon-pill
  CI:     secrets.SHANNON_UI_CHECKOUT_TOKEN — docs/SHANNON_UI.md
  Then:   ./scripts/shannon start"
  fi
  command -v swift >/dev/null || die "swift not found (install Xcode)"
  info "Building Shannon UI release from ${PILL}…"
  (
    cd "${PILL}"
    if ! ./Scripts/make_app.sh release; then
      die "Build failed"
    fi
  )
  local src="${PILL}/build/ShannonPill.app"
  [[ -d "${src}" ]] || die "Build did not produce ${src}"

  info "Installing → ${APP}"
  if [[ -e "${APP}" && ! -w "${APP}" ]]; then
    die "Cannot write ${APP} (permission denied). Once: sudo rm -rf ${APP}"
  fi
  rm -rf "${APP}"
  ditto "${src}" "${APP}"
  codesign --force --deep --sign - --timestamp=none "${APP}" 2>/dev/null \
    || warn "codesign warning (may still launch)"
  xattr -dr com.apple.quarantine "${APP}" 2>/dev/null || true
  ok "Installed Shannon UI at ${APP}"
}

status_app() {
  # Headless Shannon CLI path — never launches Shannon UI / AppKit.
  info "Shannon CLI status (headless; does not open Shannon UI)"
  doctor_hub
  if is_running; then
    [[ -x "${BIN}" ]] && info "Shannon UI binary: ${BIN}"
  else
    [[ -x "${BIN}" ]] && info "Shannon UI installed at ${APP}" || info "Shannon UI not installed — ./scripts/shannon app"
  fi
}

doctor_hub() {
  # Gate / DB / bridge honesty for operators (P0.3 / P1.1).
  # Reports: ShannonPill, gate sock, hub DB + age, pending asks, pill.sock, pets.
  local sock="/tmp/shannon.sock"
  local db="${HOME}/.shannon/agent_hub.db"
  local pill="${HOME}/.shannon/pill.sock"

  if is_running; then
    ok "ShannonPill: running (pid $(pgrep -x ShannonPill | tr '\n' ' '))"
  else
    info "ShannonPill: not running"
  fi

  if [[ -S "${sock}" ]] || [[ -e "${sock}" ]]; then
    ok "Gate socket: ${sock} (up)"
  else
    info "Gate socket: ${sock} (offline — ./scripts/shannon gate)"
  fi

  if [[ -f "${db}" ]]; then
    local age
    age="$(( $(date +%s) - $(stat -f %m "${db}" 2>/dev/null || stat -c %Y "${db}" 2>/dev/null || echo 0) ))"
    ok "Hub DB: ${db} (mtime age ${age}s)"
    local pending="?"
    if command -v sqlite3 >/dev/null 2>&1; then
      pending="$(sqlite3 "${db}" "SELECT COUNT(*) FROM agent_interactions WHERE status='pending';" 2>/dev/null || echo "?")"
    else
      pending="$(python3 -c "
import sqlite3
try:
    print(sqlite3.connect('${db}').execute(
        \"SELECT COUNT(*) FROM agent_interactions WHERE status='pending'\"
    ).fetchone()[0])
except Exception:
    print('?')
" 2>/dev/null || echo "?")"
    fi
    info "Pending asks: ${pending}"
  else
    info "Hub DB: missing (${db})"
    info "Pending asks: ?"
  fi

  if [[ -S "${pill}" ]] || [[ -e "${pill}" ]]; then
    ok "pill.sock: ${pill} (up)"
  else
    info "pill.sock: missing (${pill}) — optional live H bridge"
  fi

  if [[ -d "${PETS_DIR}" ]]; then
    local n
    n="$(find "${PETS_DIR}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
    info "Pets: ${n} under ${PETS_DIR}"
  else
    info "Pets: none yet (run ./scripts/shannon pets)"
  fi
}

probe_app() {
  doctor_hub
  echo
  if [[ -x "${BIN}" ]]; then
    info "Shannon UI --probe:"
    "${BIN}" --probe
    return $?
  fi
  if [[ -n "${PILL}" ]]; then
    local local_bin="${PILL}/build/ShannonPill.app/Contents/MacOS/ShannonPill"
    if [[ -x "${local_bin}" ]]; then
      info "Shannon UI --probe (local ShannonUI build):"
      "${local_bin}" --probe
      return $?
    fi
  fi
  warn "No Shannon UI binary for --probe. Install ShannonUI or: ./scripts/shannon app"
  return 0
}

# Short-lived AgentClient demo against the live gate.
agent_demo() {
  local demo_py="${HUB}/tools/agent_demo.py"
  [[ -f "${demo_py}" ]] || die "Missing ${demo_py}"
  PYTHONPATH="${HUB}${PYTHONPATH:+:$PYTHONPATH}" python3 "${demo_py}" "$@"
}

# ── Pets (always offline-safe) ────────────────────────────────────────────────

bootstrap_pets() {
  info "Bootstrapping pets under ${PETS_DIR}…"
  mkdir -p "${HOME}/.shannon"
  # Prefer hub pet_manager when present; pure-Python fallback otherwise.
  if [[ -f "${HUB}/pet_manager.py" ]]; then
    PYTHONPATH="${HUB}${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY' || true
from pet_manager import PetManager, ALL_AGENTS
pm = PetManager()
for a in ALL_AGENTS:
    pm.ensure_pet(a)
    print(f"  pet ready: {a}")
print(f"ok {len(ALL_AGENTS)} pets via pet_manager")
PY
  fi
  # Guarantee core set even if pet_manager import failed.
  python3 - <<'PY'
import json, os, time
from pathlib import Path
home = Path(os.environ.get("SHANNON_LOG_DIR", Path.home() / ".shannon"))
pets = home / "pets"
pets.mkdir(parents=True, exist_ok=True)
agents = [
    ("claude_code", "Claude"),
    ("codex", "Codex"),
    ("chatgpt", "ChatGPT"),
    ("grok_build", "Grok"),
    ("terminal", "Terminal"),
    ("browser", "Browser"),
    ("cursor", "Cursor"),
    ("dataset_runner", "DatasetRunner"),
    ("science", "Science"),
    ("dispatch", "Dispatch"),
    ("cowork", "Cowork"),
]
for aid, name in agents:
    d = pets / aid
    d.mkdir(parents=True, exist_ok=True)
    for fname in ("memory.md", "history.jsonl"):
        f = d / fname
        if not f.exists():
            if fname == "memory.md":
                f.write_text(f"# {name}\n\nPet memory for agent `{aid}`.\n", encoding="utf-8")
            else:
                f.touch()
    cfg = d / "config.json"
    if not cfg.exists():
        cfg.write_text(json.dumps({
            "voice_enabled": True,
            "notify_threshold": 3.5,
            "memory_limit_kb": 256,
            "display_name": name,
        }, indent=2), encoding="utf-8")
    st = d / "state.json"
    if not st.exists():
        st.write_text(json.dumps({
            "status": "idle",
            "last_task": "",
            "last_cf_delta": None,
            "memory_size": 0,
            "history_count": 0,
            "updated_at": time.time(),
            "resumable": False,
        }, indent=2), encoding="utf-8")
    print(f"  ensured: {aid}")
print("ok pets under", pets)
PY
  local n
  n="$(find "${PETS_DIR}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
  ok "Pets ready (${n}) → ${PETS_DIR}"
}

# ── Optional daemons (best-effort) ────────────────────────────────────────────

start_gate() {
  info "Starting Shannon gate (optional agent broker)…"
  if pgrep -f "shannon_gate.py" >/dev/null 2>&1; then
    ok "Gate already running"
    return 0
  fi
  [[ -f "${HUB}/shannon_gate.py" ]] || { warn "No hub/shannon_gate.py — skip"; return 0; }
  mkdir -p "${HOME}/.shannon"
  # Free default HTTP port if a stale process holds it (common after crashed gate).
  local port="${SHANNON_HTTP_PORT:-8765}"
  local hold
  hold="$(lsof -nP -iTCP:"${port}" -sTCP:LISTEN -t 2>/dev/null || true)"
  if [[ -n "${hold}" ]]; then
    warn "Port ${port} busy (pid ${hold}) — attempting to free for gate"
    # shellcheck disable=SC2086
    kill ${hold} 2>/dev/null || true
    sleep 0.4
    # shellcheck disable=SC2086
    kill -9 ${hold} 2>/dev/null || true
  fi
  rm -f /tmp/shannon.sock
  nohup python3 "${HUB}/shannon_gate.py" \
    --http-port "${port}" \
    >>"${HOME}/.shannon/gate.log" 2>&1 &
  sleep 0.8
  if pgrep -f "shannon_gate.py" >/dev/null 2>&1; then
    ok "Gate up (log: ~/.shannon/gate.log, port ${port})"
  else
    warn "Gate did not start (pill works offline). See ~/.shannon/gate.log"
  fi
}

start_bridge_demo() {
  info "Starting pill bridge demo (optional live H)…"
  if pgrep -f "shannon.pill_bridge" >/dev/null 2>&1; then
    ok "Bridge already running"
    return 0
  fi
  local py="python3"
  [[ -x "${REPO}/.venv/bin/python" ]] && py="${REPO}/.venv/bin/python"
  if ! "${py}" -c "import shannon" 2>/dev/null; then
    warn "Python package not installed — pill uses local idle H (ok)."
    warn "Optional: pip install -e '.[dev]' then re-run for live bridge."
    return 0
  fi
  mkdir -p "${HOME}/.shannon"
  nohup "${py}" -m shannon.pill_bridge --demo \
    >>"${HOME}/.shannon/bridge.log" 2>&1 &
  sleep 0.5
  if pgrep -f "shannon.pill_bridge" >/dev/null 2>&1; then
    ok "Bridge demo up (log: ~/.shannon/bridge.log)"
  else
    warn "Bridge did not start — pill still shows agent pets + idle H"
  fi
}

# ── Primary bootstrap ─────────────────────────────────────────────────────────

finish_banner() {
  echo
  ok "Shannon UI is ready"
  echo
  printf '  Next (Shannon UI):\n'
  printf '    1. Look for the menu-bar Shannon glyph (○ ready / agent name)\n'
  printf '    2. Press ⌘D in Terminal, Claude, ChatGPT, Codex, or a browser\n'
  printf '       to attach that app as an agent + pet\n'
  printf '    Clipboard tip:  agent: science fix the CF floor\n'
  printf '    Pets:           ls ~/.shannon/pets\n'
  printf '    Gate (CLI):     ./scripts/shannon gate  (headless; feeds the pill)\n'
  printf '    Quit UI:        menu → Quit Shannon   or  ./scripts/shannon stop\n'
  printf '    CLI help:       ./scripts/shannon help  |  shannon-monitor --help\n'
  echo
}

bootstrap_all() {
  # 1) Pets first so disk state exists even if the app build fails later.
  bootstrap_pets
  # 2) Optional enhancements (never hard-fail bootstrap).
  start_gate || true
  start_bridge_demo || true
  # 3) Shannon UI: rebuild if missing or SHANNON_FORCE_BUILD=1 (needs ShannonUI tree).
  if [[ ! -x "${BIN}" || "${SHANNON_FORCE_BUILD:-0}" == "1" ]]; then
    if [[ -n "${PILL}" ]]; then
      stop_app || true
      build_and_install
    else
      warn "Shannon UI source not in this repo (see docs/SHANNON_UI.md / ${SHANNON_UI_URL})"
      if [[ -x "${BIN}" ]]; then
        ok "Shannon UI already installed at ${APP}"
      else
        warn "No Shannon UI app yet — CLI/hub still ready. Clone ShannonUI or use the cask."
      fi
    fi
  else
    ok "Shannon UI already installed (${APP})"
  fi
  if [[ -x "${BIN}" ]]; then
    start_app
  fi
  finish_banner
}

app_only() {
  stop_app || true
  build_and_install
  start_app
  bootstrap_pets
  finish_banner
}

usage() {
  cat <<'EOF'
shannon — Shannon UI + Shannon CLI operator handrail

This monorepo ships two named products (not one mixed binary):

  Shannon UI   macOS menu-bar / notch operator HUD (Pill → Shannon.app)
  Shannon CLI  headless entropy, gate, agent, and science tooling

── Shannon UI (macOS HUD — separate repo LeBonhommePharma/ShannonUI) ─────────
PRIMARY (pets + optional gate; UI when ShannonUI checkout or app is present):
  ./scripts/shannon                 pets + optional gate/bridge (+ UI if available)
  ./scripts/shannon start|stop|restart
  ./scripts/shannon pets            create default pet directories
  ./scripts/shannon app             rebuild & install UI (needs ShannonUI tree)
  ./scripts/shannon update          rebuild UI from ShannonUI checkout if present

Shannon UI source (private repo — not in this monorepo):
  git clone git@github.com:LeBonhommePharma/ShannonUI.git ../ShannonUI
  # or: gh repo clone LeBonhommePharma/ShannonUI ../ShannonUI
  export SHANNON_UI_ROOT=../ShannonUI   # optional; sibling path is auto-detected
  ./scripts/shannon app
  # or published cask: brew install --cask lebonhommepharma/shannon/shannon-pill
  # CI: secrets.SHANNON_UI_CHECKOUT_TOKEN (see docs/SHANNON_UI.md)

In Shannon UI:
  ⌘D   Capture the frontmost app as an agent + pet.
       Clipboard:  agent: science my task summary

── Shannon CLI (this repo — headless, no AppKit / no ShannonPill launch) ─────
  ./scripts/shannon status|probe|doctor   hub + install diagnostics (no GUI open)
  ./scripts/shannon gate                  start agent gate daemon only
  ./scripts/shannon agent …               hub agent manager (spawn|control|monitor|kill|roster)
  ./scripts/shannon agent-demo            live socket demo agent (needs gate)
  ./scripts/shannon export                session timeline JSONL
  ./scripts/shannon science               pure-Python library from this clone
  ./scripts/shannon skill-install         install Shannon skill into Claude/Codex/Grok/OpenCode
  ./scripts/shannon grok|claude|codex …   Ori-style harness (real CLI on PATH)
  ./scripts/shannon help                  this dual-product map

  shannon grok | shannon claude | shannon codex
                                          Ori-style agent harness (real CLI on PATH)
  shannon-monitor --help                  Python entropy collapse monitor (Shannon CLI)
  python3 -m shannon grok --dry-run       same harness without the console script
  python3 -m agent_manager --help         same agent manager as `./scripts/shannon agent`
  hub/shannon_gate.py --help              Shannon Gate daemon flags
  shannon-agent --help                    optional C++ stream referee (Homebrew formula)

Science library (all platforms — Shannon CLI):
  ./scripts/install_shannon.sh --path          macOS/Linux from clone
  ./scripts/Install-Shannon.ps1 -Source path   Windows from clone

Optional:
  brew install …/shannon               Shannon CLI (shannon-agent)
  brew install --cask …/shannon-pill   Shannon UI signed release (when published)
  docs/SHANNON_UI.md                   product boundary + ShannonUI clone map

Legacy dual status-item hub UI is archived under archive/legacy_agent_hub_ui/
and is not part of Shannon UI or Shannon CLI production paths.
EOF
}

case "${CMD}" in
  bootstrap|hub|up|"")
    bootstrap_all
    ;;
  app|run|r)
    app_only
    ;;
  install|i|update|upgrade)
    # Rebuild Shannon UI when ShannonUI checkout is available; else pets only.
    stop_app || true
    if [[ -n "${PILL}" ]]; then
      build_and_install
    else
      warn "No ShannonUI checkout — skipped app rebuild (docs/SHANNON_UI.md)"
    fi
    bootstrap_pets
    ok "Installed/updated. Start UI with: ./scripts/shannon start (if app present)"
    ;;
  science|lib|python-install)
    # Pure-Python science package from this monorepo (cross-platform helper).
    exec "${REPO}/scripts/install_shannon.sh" --path --update "$@"
    ;;
  fleet|bonhomme-fleet)
    # Bonhomme Fleet lives in ShannonUI (ShannonCore / PillCore).
    info "Bonhomme Fleet (Shannon UI / ShannonCore — not in this CLI repo)"
    python3 - <<'PY'
print("Fleet tests live in LeBonhommePharma/ShannonUI:")
print("  cd ../ShannonUI/Packages/ShannonCore && swift test --filter BonhommeFleetTests")
print("  cd ../ShannonUI/Pill && swift test --filter BonhommeFleetMacStatusTests")
print("See docs/SHANNON_UI.md")
PY
    ok "Fleet tests are authoritative in ShannonUI"
    ;;
  natural|sci|hrv)
    info "NATURaL SCI (Shannon UI / ShannonCore — not in this CLI repo)"
    python3 - <<'PY'
print("NATURaL SCI unit tests live in LeBonhommePharma/ShannonUI:")
print("  cd ../ShannonUI/Packages/ShannonCore && swift test --filter NaturalSCITests")
print("See docs/SHANNON_UI.md")
PY
    ok "SCI unit tests are authoritative in ShannonUI"
    ;;
  start|open)
    start_app
    ;;
  stop|kill|down)
    stop_app
    ;;
  restart)
    stop_app
    start_app
    ;;
  status|st)
    status_app
    ;;
  probe|doctor)
    probe_app
    ;;
  pets|pet)
    bootstrap_pets
    ;;
  gate)
    start_gate
    ;;
  agent-demo|demo)
    agent_demo "$@"
    ;;
  agent|agents|hub-agent)
    # Shannon hub agent manager — spawn/control/monitor/kill handrail.
    # Example: ./scripts/shannon agent roster
    #          ./scripts/shannon agent spawn science --dry-run
    export PYTHONPATH="${HUB}${PYTHONPATH:+:$PYTHONPATH}"
    exec python3 -m agent_manager "$@"
    ;;
  skill-install|install-skill)
    python3 "${REPO}/skills/shannon/scripts/install_skill.py" "$@"
    ;;
  export|session-export)
    # write_jsonl(path, events=None, *, db_path=...) — path is OUTPUT, not DB.
    python3 - "${HUB}" <<'PY'
import sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
from session_export import write_jsonl
db = Path.home() / ".shannon" / "agent_hub.db"
out = Path.home() / ".shannon" / "session_export.jsonl"
n = write_jsonl(out, db_path=db)
print(f"wrote {n} events → {out}")
PY
    ;;
  help|-h|--help)
    usage
    ;;
  claude|claude_code|cc|claudecode|codex|openai_codex|grok|grok_build|xai|grokbuild|opencode|open_code|oc|kimi|hermes|pi|cursor|prime-agent|prime_agent|primeagent)
    # Ori-style: ./scripts/shannon grok  →  python -m shannon.cli grok …
    export PYTHONPATH="${REPO}/python:${HUB}${PYTHONPATH:+:$PYTHONPATH}"
    exec python3 -m shannon.cli "${CMD}" "$@"
    ;;
  *)
    die "Unknown command: ${CMD}. Try: ./scripts/shannon help"
    ;;
esac
